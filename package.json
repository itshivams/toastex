{
  "name": "toastex",
  "version": "1.0.2",
  "description": "A robust, enterprise-standard vanilla JS/TS toast notification library.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./toastex.css": "./dist/toastex.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "rm -rf example/dist && cp -r dist example/",
    "dev": "tsup --watch"
  },
  "keywords": [
    "toast",
    "notification",
    "alert",
    "snackbar",
    "toastex",
    "vanilla",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}